# Optional: live bounding-box view for demos and local debugging.
# Not required for the safety/passenger pipeline itself.
[Unit]
Description=Stream Viewer — WebSocket server for browser UI
After=camera-capture.service
Requires=camera-capture.service

[Container]
Image=quay.io/luisarizmendi/video-action-recognition-stream-viewer:latest
ContainerName=stream-viewer

Volume=/dev/shm:/dev/shm
Network=host
SecurityLabelDisable=true

Environment=SHM_FRAME_NAME=camera_frame
Environment=ZMQ_SUB_HOST=localhost
Environment=ZMQ_SUB_PORT=5555
Environment=HTTP_PORT=8080

PublishPort=8080:8080

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
