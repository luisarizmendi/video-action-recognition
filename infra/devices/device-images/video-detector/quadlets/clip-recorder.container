[Unit]
Description=Clip Recorder — SHM ring buffer → evidence clips on trigger
After=camera-capture.service
Requires=camera-capture.service

[Container]
Image=quay.io/luisarizmendi/video-action-recognition-clip-recorder:latest
ContainerName=clip-recorder

Volume=/dev/shm:/dev/shm
Volume=/var/home/detector/clips:/clips

Network=host
SecurityLabelDisable=true

Environment=SHM_FRAME_NAME=camera_frame
Environment=CLIP_DIR=/clips
Environment=PREROLL_S=8
Environment=POSTROLL_S=4
Environment=CALLBACK_URL=http://localhost:8081/v1/clip-ready

PublishPort=8082:8080

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
