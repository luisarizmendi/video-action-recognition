# Image mode OS for the video-detector device (x86_64). Podman + Quadlets is
# the base deployment for this device image; see ../../../devices/device-images
# README and the microshift/ subfolder if you want MicroShift instead.
#
# Build (context is the repo root):
#   podman build -f infra/devices/device-images/video-detector/Containerfile \
#     -t quay.io/luisarizmendi/video-action-recognition-os:latest .
FROM registry.redhat.io/rhel9/rhel-bootc:latest

# TODO: enable the repos you need at build time (rhel-9-baseos/appstream,
# fast-datapath, nvidia) using your subscription, e.g. with a build secret.
RUN dnf install -y podman v4l-utils ffmpeg && dnf clean all

# TODO: NVIDIA driver + container toolkit + CDI spec for `AddDevice=nvidia.com/gpu=all`
# in the quadlets, if this box has a desktop/server GPU. Not needed for CPU-only ONNX.

COPY infra/devices/device-images/video-detector/quadlets/ /etc/containers/systemd/

# TODO: /etc/containers/registries.conf pull secret for quay.io/luisarizmendi
RUN mkdir -p /var/home/detector/videos /var/home/detector/models \
             /var/home/detector/clips /var/home/detector/outbox /etc/video-action-recognition
LABEL containers.bootc=1
