# Image mode OS for the video-detector device on NVIDIA Jetson (JetPack 6.x,
# aarch64). Same service set as the x86_64 video-detector image, but the
# inference quadlet uses inference-tensorrt-jetson (L4T TensorRT base)
# instead of inference-onnx.
#
# This follows the pattern of https://github.com/luisarizmendi/bootc-images
# (rhel-jetson-object-detection): a RHEL bootc image built for Tegra with the
# NVIDIA L4T userspace and JetPack packages layered in. That repo's Jetson
# base layer is the right starting point for the FROM line and the NVIDIA
# package set below; treat this Containerfile as the service-wiring half, not
# a full from-scratch Jetson bootc recipe.
#
# Build must run on aarch64 (or with cross-arch emulation):
#   podman build --platform linux/arm64 \
#     -f infra/devices/device-images/video-detector-jetson/Containerfile \
#     -t quay.io/luisarizmendi/video-action-recognition-os-jetson:latest .
FROM registry.redhat.io/rhel9/rhel-bootc:latest

# TODO: layer in the Jetson/L4T userspace and JetPack packages, following
# https://github.com/luisarizmendi/bootc-images/tree/main/rhel-jetson-object-detection
RUN dnf install -y podman v4l-utils ffmpeg && dnf clean all

COPY infra/devices/device-images/video-detector-jetson/quadlets/ /etc/containers/systemd/

RUN mkdir -p /var/home/detector/videos /var/home/detector/models \
             /var/home/detector/clips /var/home/detector/outbox /etc/video-action-recognition
LABEL containers.bootc=1
