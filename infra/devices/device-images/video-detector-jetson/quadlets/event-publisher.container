[Unit]
Description=Event Publisher — durable outbox, S4 upload, AMQ Streams producer
After=network-online.target
Wants=network-online.target

[Container]
Image=quay.io/CHANGEME/video-action-recognition-event-publisher:latest
ContainerName=event-publisher

Volume=/var/home/detector/outbox:/var/lib/outbox
Volume=/var/home/detector/clips:/clips
Volume=/etc/video-action-recognition:/etc/bus-edge:ro

Network=host
SecurityLabelDisable=true

Environment=OUTBOX_PATH=/var/lib/outbox/outbox.db
Environment=TOPIC_SAFETY=bus.safety.events
Environment=TOPIC_PASSENGER=bus.passenger.counts
Environment=TOPIC_HEALTH=bus.edge.health

PublishPort=8083:8080

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
