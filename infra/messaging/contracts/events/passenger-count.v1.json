{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PassengerCount v1",
  "description": "Published to topic bus.passenger.counts. One message per time window.",
  "type": "object",
  "required": ["schema_version", "event_id", "bus_id", "camera_id", "window_start", "window_end", "occupancy", "boarded", "alighted"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "bus_id": {"type": "string"},
    "camera_id": {"type": "string"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "occupancy": {"type": "integer", "minimum": 0},
    "boarded": {"type": "integer", "minimum": 0},
    "alighted": {"type": "integer", "minimum": 0}
  }
}
