FROM registry.access.redhat.com/ubi9/python-311:latest
WORKDIR /opt/app-root/src
RUN pip install --no-cache-dir fastapi==0.115.6 uvicorn==0.34.0 requests==2.32.3 \
    opencv-python-headless==4.10.0.84 numpy==2.1.3
COPY src/ ./src/
ENV PYTHONPATH=/opt/app-root/src/src
EXPOSE 8080
CMD ["uvicorn", "recorder.main:app", "--host", "0.0.0.0", "--port", "8080"]
